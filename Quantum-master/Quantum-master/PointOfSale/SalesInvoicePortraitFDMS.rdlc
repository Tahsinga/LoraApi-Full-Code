  <DataSets>
    <DataSet Name="PaymentMethods">
      <Query>
        <DataSourceName>POSDataSet</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="InvoiceNumber">
          <DataField>InvoiceNumber</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PaymentMethodID">
          <DataField>PaymentMethodID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PaymentMethodDesc">
          <DataField>PaymentMethodDesc</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AmountPaid">
          <DataField>AmountPaid</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="EntryNo">
          <DataField>EntryNo</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
