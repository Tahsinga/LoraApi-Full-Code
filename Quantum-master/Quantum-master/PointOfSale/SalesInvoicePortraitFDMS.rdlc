                          <TextRuns>
                            <TextRun>
                              <Value>="(" &amp; math.Round(Sum(Fields!DiscountAmt.Value * Fields!Quantity.Value * Fields!ReceiptDisplayRate.Value),2) &amp; ")"</Value>
