                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Microsoft.VisualBasic.Interaction.iif(Fields!DiscountAmt.Value = 0, "", System.Math.round(Fields!DiscountAmt.Value * Fields!Quantity.Value * Fields!ReceiptDisplayRate.Value, 2))</Value>
