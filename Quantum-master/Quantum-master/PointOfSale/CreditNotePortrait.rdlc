          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Customer Address: " &amp; iif(parameters!LeafbrightA4.Value=1,First(Fields!streetnumber.Value, "CustomerDetails") &amp; ", " &amp; First(Fields!Address.Value, "CustomerDetails") &amp; ", " &amp; First(Fields!city.Value, "CustomerDetails") &amp; ", " &amp; First(Fields!province.Value, "CustomerDetails") , First(Fields!Address.Value, "CustomerDetails")) &amp; chr(13) &amp; chr(10) &amp; "Customer City: " &amp; First(Fields!city.Value, "CustomerDetails") &amp; chr(13) &amp; chr(10) &amp; "Customer Province: " &amp; First(Fields!province.Value, "CustomerDetails") &amp; chr(13) &amp; chr(10) &amp; "Customer Phone Number: " &amp; First(Fields!Mobile.Value, "CustomerDetails") &amp; chr(13) &amp; chr(10) &amp; "Customer Email Address: " &amp; First(Fields!Email.Value, "CustomerDetails")</Value>
                <Style>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
