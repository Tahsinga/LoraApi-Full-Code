                    <Textbox Name="Description">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=iif(parameters!IsWarehouse.Value,  Fields!Description.Value.ToString + System.Environment.NewLine + "Batch Number: " + Fields!BatchNumber.Value.ToString + " Expiry Date: " +Fields!ExpiryDate.Value.ToString,Fields!Description.Value.ToString)</Value>
                              <Style>
                                <FontSize>8pt</FontSize>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
