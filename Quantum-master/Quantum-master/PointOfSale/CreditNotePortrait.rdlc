                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Sub_Total">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Round( (round(Fields!Sub_TotalExcl.Value,5) + Fields!TaxAmt.Value) * fields!ReceiptDisplayRate.value,2)</Value>
