                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Round( (Fields!Unit_Selling_Price.Value + (Fields!DiscountAmt.Value * -1)) * fields!ReceiptDisplayRate.Value,2)</Value>
