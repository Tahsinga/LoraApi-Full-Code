                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Round( (Fields!Sub_TotalExcl.Value + Fields!TaxAmt.Value) * fields!ReceiptDisplayRate.value,2)</Value>
